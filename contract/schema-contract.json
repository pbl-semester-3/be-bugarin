{
  "version": 1,
  "note": "Dihasilkan otomatis dari schema Zod backend. Aturan .refine()/lintas-field tidak tercakup.",
  "schemas": {
    "auth.login": {
      "emailOrUsername": {
        "optional": false,
        "type": "string",
        "minLength": 1
      },
      "password": {
        "optional": false,
        "type": "string",
        "minLength": 1
      }
    },
    "pt.changePassword": {
      "passwordBaru": {
        "optional": false,
        "type": "string",
        "minLength": 8
      },
      "passwordSaatIni": {
        "optional": false,
        "type": "string",
        "minLength": 1
      }
    },
    "pt.updateProfile": {
      "nama": {
        "optional": true,
        "type": "string",
        "minLength": 2
      },
      "usia": {
        "optional": true,
        "type": "integer",
        "minimum": 13
      },
      "whatsapp": {
        "optional": true,
        "type": "string"
      }
    }
  }
}
