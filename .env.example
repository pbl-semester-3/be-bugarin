# ==== Database ====
# Lokal (docker-compose, port 3307 — sengaja beda dari 3306 default Laragon/MySQL lokal, biar tidak bentrok)
# Aiven (dev/staging): salin "Service URI" dari dashboard Aiven, format: mysql://user:pass@host:port/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=mysql://bugarin:bugarin_dev@localhost:3307/bugarin_dev

# ==== Auth ====
# Generate string acak panjang, minimal 32 karakter. Contoh: openssl rand -base64 32
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# ==== AI ====
# Ambil dari https://aistudio.google.com/apikey
GEMINI_API_KEY=ganti_dengan_api_key_gemini_kamu

# ==== CORS ====
# Origin Frontend Next.js yang boleh akses backend ini
WEB_ORIGIN=http://localhost:3000

# ==== Server ====
PORT=4000
NODE_ENV=development

# ==== Cron Trigger (untuk endpoint /internal/jobs/generate-weekly-plan) ====
# Secret untuk validasi request dari cron-job.org, cegah orang lain trigger job ini
CRON_SECRET=ganti_dengan_string_acak_lain

# ==== Cloudinary (foto profil klien) ====
# Ambil satu baris "API environment variable" dari dashboard Cloudinary, format:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
# Kalau dikosongkan, endpoint foto profil mengembalikan 503 (fitur foto nonaktif).
CLOUDINARY_URL=
# Opsional: folder penyimpanan di Cloudinary
CLOUDINARY_FOLDER=bugarin/klien
